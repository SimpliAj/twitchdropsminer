      "how_to_use_items": [
        "\u4f7f\u7528\u60a8\u7684 Twitch \u8d26\u53f7\u767b\u5f55\uff08OAuth \u8bbe\u5907\u4ee3\u7801\u6d41\u7a0b\uff09",
        "\u5728 <a href=\"https://www.twitch.tv/drops/campaigns\" target=\"_blank\">twitch.tv/drops/campaigns</a> \u5173\u8054\u60a8\u7684\u8d26\u53f7",
        "\u77ff\u5de5\u5c06\u81ea\u52a8\u53d1\u73b0\u6d3b\u52a8\u5e76\u5f00\u59cb\u6316\u6398",
        "\u5728\u8bbe\u7f6e\u4e2d\u914d\u7f6e\u4f18\u5148\u6e38\u620f\u4ee5\u5173\u6ce8\u60a8\u60f3\u8981\u7684\u5185\u5bb9",
        "\u5728\u4e3b\u754c\u9762\u548c\u5e93\u5b58\u9009\u9879\u5361\u4e2d\u76d1\u63a7\u8fdb\u5ea6"
