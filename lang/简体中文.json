    "help": {
      "about": "\u5173\u4e8e Twitch \u6389\u5b9d\u77ff\u5de5",
      "about_text": "\u6b64\u5e94\u7528\u7a0b\u5e8f\u53ef\u5728\u4e0d\u4e0b\u8f7d\u6d41\u6570\u636e\u7684\u60c5\u51b5\u4e0b\u81ea\u52a8\u6316\u6398\u5b9a\u65f6 Twitch \u6389\u5b9d\u3002",
